      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Classify with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://app:8081/api/reviews/digest",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "days",
              "value": "7"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Get weekly digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Arma el mensaje de Discord a partir de la respuesta de /api/reviews/digest.\n// Discord acepta hasta 2000 caracteres por mensaje.\nconst d = $input.first().json;\nconst c = d.byCategory;\n\nconst line = (r) => {\n  const text = r.excerpt.length > 160 ? r.excerpt.slice(0, 160) + '…' : r.excerpt;\n  return `> ${r.votedUp ? '👍' : '👎'} *[${r.language}]* ${text}`;\n};\n\nlet content;\nif (d.total === 0) {\n  content = `**📊 Goblin Cleanup: weekly review digest**\\nNo new reviews in the last ${d.days} days.`;\n} else {\n  content = [\n    `**📊 Goblin Cleanup: weekly review digest** (last ${d.days} days)`,\n    `**${d.total}** new reviews · **${d.positivePercent}%** positive`,\n    `🐛 Bugs: **${c.BUG}** · 💡 Requests: **${c.FEATURE_REQUEST}** · 👍 Positive: **${c.POSITIVE}** · Other: ${c.OTHER}`,\n  ].join('\\n');\n\n  if (d.topBugs.length) {\n    content += `\\n\\n**🐛 Latest bug reports**\\n` + d.topBugs.map(line).join('\\n');\n  }\n  if (d.topFeatureRequests.length) {\n    content += `\\n\\n**💡 Latest feature requests**\\n` + d.topFeatureRequests.map(line).join('\\n');\n  }\n}\n\nif (content.length > 2000) {\n  content = content.slice(0, 1997) + '…';\n}\nreturn [{ json: { content } }];\n"
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Format Discord message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.content }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ]
    }
  ],
